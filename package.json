{
  "name": "my-portfolio",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm run dev -w @my-portfolio/portfolio\" \"npm run dev -w @my-portfolio/api\"",
    "build": "npm run build -w @my-portfolio/portfolio",
    "preview": "npm run preview -w @my-portfolio/portfolio",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p scripts",
    "test": "node --import tsx --test \"packages/**/*.test.ts\" \"apps/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "eval": "node --env-file-if-exists=.env --import tsx scripts/eval.ts",
    "ingest": "node --env-file-if-exists=.env --import tsx scripts/ingest.ts",
    "check:pinecone": "node --env-file-if-exists=.env --import tsx scripts/check-pinecone.ts",
    "chat": "node --env-file-if-exists=.env --import tsx scripts/chat.ts",
    "dev:web": "npm run dev -w @my-portfolio/portfolio",
    "dev:api": "npm run dev -w @my-portfolio/api",
    "build:api": "npm run build -w @my-portfolio/api",
    "resume": "node --import tsx scripts/resume.ts",
    "smoke": "node --import tsx scripts/smoke.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.6",
    "concurrently": "^10.0.6",
    "pdfkit": "^0.20.2",
    "tsx": "^4.23.15"
  }
}
