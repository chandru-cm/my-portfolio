{
  "name": "my-portfolio",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @my-portfolio/portfolio",
    "build": "npm run build -w @my-portfolio/portfolio",
    "preview": "npm run preview -w @my-portfolio/portfolio",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=18"
  }
}
