# Copy to .env and fill in. .env is git-ignored. Never commit real keys.

# Google AI Studio key (free tier). https://aistudio.google.com
GEMINI_API_KEY=
# Optional overrides
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSIONS=768

# Pinecone free plan. Create a serverless index first:
#   metric: cosine, dimensions: must equal EMBEDDING_DIMENSIONS (768 by default)
PINECONE_API_KEY=
PINECONE_INDEX=
# PINECONE_NAMESPACE=portfolio

# Similarity cut-off below which the bot says "I don't know". Tune with `npm run eval -- --gemini`.
# RETRIEVAL_THRESHOLD=0.6

# ---- Website (read by Vite from this root file; only VITE_ values reach the browser) ----
# Where the chat API lives. Leave empty to use the dev proxy, which npm run dev sets up.
# Set it to call a server directly, for example the local API:
# VITE_API_BASE_URL=http://localhost:8787
# Show the chat button in a production build (set in Vercel once the API is deployed):
# VITE_CHAT_ENABLED=true

# ---- Chat backend (apps/api) ----
# Chat model, measured on the free tier. Availability swings by the hour: gemini-3.1-flash-lite answered in
# 7 to 12 s at one point and returned 503 on every try at another, while gemini-3.5-flash-lite did the reverse.
# That is why the fallback list mixes both families. Full Flash models often return 503 (overloaded).
# Re-measure before changing; model names are IDs (lowercase, hyphens), never display names.
# Both have working defaults, so you can leave these lines out.
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
# Tried in order if the primary is slow or overloaded (comma separated)
GEMINI_CHAT_FALLBACK_MODELS=gemini-3.1-flash-lite-preview,gemini-3.5-flash-lite
# Give up on a model if it has produced no text after this long
# GEMINI_FIRST_TOKEN_TIMEOUT_MS=15000

# Optional: the index host from the Pinecone console. Skips a ~3 s lookup on every cold start.
# PINECONE_INDEX_HOST=

# Questions that closely match an approved FAQ answer are answered instantly, with no model call (0.80 default)
# FAQ_FAST_PATH_THRESHOLD=0.8

# Production only (set these in Vercel, not here): exact site origin(s), comma separated, no trailing slash
# ALLOWED_ORIGINS=https://your-site.vercel.app
# Upstash Redis (free) for rate limiting across serverless instances
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional limits (defaults: 10 per minute and 40 per day per visitor, 500 per day overall)
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_PER_DAY=40
# GLOBAL_DAILY_LIMIT=500
