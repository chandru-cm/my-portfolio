# Copy to .env and fill in. .env is git-ignored. Never commit real keys.

# Google AI Studio key (free tier). https://aistudio.google.com
GEMINI_API_KEY=
# Optional overrides
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSIONS=768

# Pinecone free plan. Create a serverless index first:
#   metric: cosine, dimensions: must equal EMBEDDING_DIMENSIONS (768 by default)
PINECONE_API_KEY=
PINECONE_INDEX=
# PINECONE_NAMESPACE=portfolio

# Similarity cut-off below which the bot says "I don't know". Tune with `npm run eval -- --gemini`.
# RETRIEVAL_THRESHOLD=0.6

# ---- Chat backend (apps/api) ----
# Chat model. Measured on the free tier (first word): gemini-3.1-flash-lite about 7 to 12 s;
# gemini-3.5-flash-lite timed out at over 30 s; full Flash models often return 503 (overloaded).
# Re-measure before changing: names and availability move quickly. List yours with the Google AI Studio model list.
# Both have working defaults, so you can leave these lines out.
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
# Tried in order if the primary is slow or overloaded (comma separated)
GEMINI_CHAT_FALLBACK_MODELS=gemini-3.1-flash-lite-preview
# Give up on a model if it has produced no text after this long
# GEMINI_FIRST_TOKEN_TIMEOUT_MS=15000

# Optional: the index host from the Pinecone console. Skips a ~3 s lookup on every cold start.
# PINECONE_INDEX_HOST=

# Questions that closely match an approved FAQ answer are answered instantly, with no model call (0.80 default)
# FAQ_FAST_PATH_THRESHOLD=0.8

# Production only (set these in Vercel, not here): exact site origin(s), comma separated, no trailing slash
# ALLOWED_ORIGINS=https://your-site.vercel.app
# Upstash Redis (free) for rate limiting across serverless instances
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional limits (defaults: 10 per minute and 40 per day per visitor, 500 per day overall)
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_PER_DAY=40
# GLOBAL_DAILY_LIMIT=500
