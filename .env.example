# Copy to .env and fill in. .env is git-ignored. Never commit real keys.

# Google AI Studio key (free tier). https://aistudio.google.com
GEMINI_API_KEY=
# Optional overrides
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSIONS=768

# Pinecone free plan. Create a serverless index first:
#   metric: cosine, dimensions: must equal EMBEDDING_DIMENSIONS (768 by default)
PINECONE_API_KEY=
PINECONE_INDEX=
# PINECONE_NAMESPACE=portfolio

# Similarity cut-off below which the bot says "I don't know". Tune with `npm run eval -- --gemini`.
# RETRIEVAL_THRESHOLD=0.6

# ---- Chat backend (apps/api) ----
# Copy the current free Flash model name from Google AI Studio. Deliberately no default.
GEMINI_CHAT_MODEL=

# Production only (set these in Vercel, not here): exact site origin(s), comma separated, no trailing slash
# ALLOWED_ORIGINS=https://your-site.vercel.app
# Upstash Redis (free) for rate limiting across serverless instances
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional limits (defaults: 10 per minute and 40 per day per visitor, 500 per day overall)
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_PER_DAY=40
# GLOBAL_DAILY_LIMIT=500
